<Page x:Class="yolo_home_camera_project.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Home"
                   Style="{StaticResource PageTitleTextStyle}"/>

        <UniformGrid Grid.Row="1"
                     Columns="3"
                     Margin="0,20,0,20">
            <Border Style="{StaticResource HomeSummaryCardStyle}"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="오늘 감지된 이벤트 수"
                               Style="{StaticResource BodyTextStyle}"/>
                    <TextBlock x:Name="TodayEventCountText"
                               Text="0개"
                               Style="{StaticResource PageTitleTextStyle}"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource HomeSummaryCardStyle}"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="오늘 분석한 영상 수"
                               Style="{StaticResource BodyTextStyle}"/>
                    <TextBlock x:Name="TodayAnalysisCountText"
                               Text="0개"
                               Style="{StaticResource PageTitleTextStyle}"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource HomeSummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="최근 분석 바로가기"
                               Style="{StaticResource BodyTextStyle}"/>
                    <TextBlock x:Name="LatestAnalysisText"
                               Text="없음"
                               Style="{StaticResource SectionTitleTextStyle}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,10,0,0"/>
                    <TextBlock x:Name="LatestAnalysisDateText"
                               Text=""
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource ContentCardStyle}"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="최근 감지 이벤트"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,0,14"/>
                    <ItemsControl x:Name="RecentEventItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Margin="0,0,0,10"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource ContentCardStyle}">
                <StackPanel>
                    <TextBlock Text="최근 보고서"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,0,14"/>
                    <ItemsControl x:Name="RecentReportItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Style="{StaticResource BodyTextStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,10"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
