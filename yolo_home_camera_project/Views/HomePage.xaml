<Page x:Class="yolo_home_camera_project.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Home"
                   Style="{StaticResource PageTitleTextStyle}"/>

        <UniformGrid Grid.Row="1"
                     Columns="3"
                     Margin="0,20,0,20">
            <Border Style="{StaticResource HomeSummaryCardStyle}"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="오늘 감지된 이벤트 수"
                               Style="{StaticResource BodyTextStyle}"/>
                    <TextBlock Text="5개"
                               Style="{StaticResource PageTitleTextStyle}"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource HomeSummaryCardStyle}"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="오늘 분석한 영상 수"
                               Style="{StaticResource BodyTextStyle}"/>
                    <TextBlock Text="5개"
                               Style="{StaticResource PageTitleTextStyle}"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource HomeSummaryCardStyle}">
                <StackPanel>
                    <TextBlock Text="최근 분석 바로가기"
                               Style="{StaticResource BodyTextStyle}"/>
                    <TextBlock Text="5개"
                               Style="{StaticResource PageTitleTextStyle}"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource ContentCardStyle}"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="최근 감지 이벤트"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,0,14"/>
                    <TextBlock Text="00:13  cat 감지"
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="00:47  person 감지"
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="01:21  fire 감지"
                               Style="{StaticResource BodyTextStyle}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource ContentCardStyle}">
                <StackPanel>
                    <TextBlock Text="최근 보고서"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Margin="0,0,0,14"/>
                    <TextBlock Text="보고서 1 (3/12)"
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="보고서 2 (3/13)"
                               Style="{StaticResource BodyTextStyle}"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="보고서 3 (3/14)"
                               Style="{StaticResource BodyTextStyle}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
