<Window x:Class="yolo_home_camera_project.Views.AnalysisProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YOLOE Analysis"
        Width="620"
        Height="320"
        MinWidth="620"
        MinHeight="320"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}">
    <Border Margin="16"
            Style="{StaticResource ContentCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="YOLOE 영상 분석"
                       Style="{StaticResource SectionTitleTextStyle}"/>

            <TextBlock x:Name="VideoNameText"
                       Grid.Row="1"
                       Style="{StaticResource MutedTextStyle}"
                       FontSize="11"
                       Margin="0,10,0,0"
                       TextTrimming="CharacterEllipsis"/>

            <TextBlock x:Name="StatusText"
                       Grid.Row="2"
                       Text="분석을 준비하고 있습니다."
                       Style="{StaticResource StatusTextStyle}"
                       FontSize="12"
                       Margin="0,14,0,8"/>

            <ProgressBar x:Name="ProgressBar"
                         Grid.Row="3"
                         Height="24"
                         IsIndeterminate="True"
                         Foreground="#FF20B53A"
                         Background="#FFE5E7EB"
                         BorderBrush="#FFD1D5DB"
                         BorderThickness="1"
                         Margin="0,8,0,0"
                         VerticalAlignment="Top"/>

            <Button x:Name="CancelButton"
                    Grid.Row="5"
                    Content="취소"
                    Style="{StaticResource BaseButtonStyle}"
                    Width="96"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0"
                    Click="CancelButton_Click"/>
        </Grid>
    </Border>
</Window>
