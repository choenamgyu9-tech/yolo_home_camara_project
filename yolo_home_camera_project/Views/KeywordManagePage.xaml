<Page x:Class="yolo_home_camera_project.Views.KeywordManagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FFF7F7F7">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Keyword Manage" FontSize="28" FontWeight="Bold"/>
        <Grid Grid.Row="1" Margin="0,20,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ComboBox SelectedIndex="0" Height="36"><ComboBoxItem Content="정렬"/></ComboBox>
            <TextBox Grid.Column="1" Margin="12,0,0,0" Height="36" Text="키워드 검색"/>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="#FFD9D9D9" BorderThickness="1" CornerRadius="6" Padding="18">
            <StackPanel>
                <TextBlock Text="키워드 목록" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/>
                <CheckBox Content="dog" IsChecked="True"/>
                <CheckBox Content="cat" IsChecked="True"/>
                <CheckBox Content="bird" IsChecked="True"/>
                <CheckBox Content="fire" IsChecked="True"/>
                <CheckBox Content="person" IsChecked="True"/>
                <CheckBox Content="refrigerator"/>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="3" Text="6개 / 80개" HorizontalAlignment="Right" Margin="0,12,0,0"/>
    </Grid>
</Page>
