<Page x:Class="yolo_home_camera_project.Views.ReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Report"
                       Style="{StaticResource PageTitleTextStyle}"/>
            <Border Height="1"
                    Background="{StaticResource PrimaryBrush}"
                    Margin="0,8,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="0,24,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ComboBox SelectedIndex="0"
                      Style="{StaticResource BaseComboBoxStyle}">
                <ComboBoxItem Content="&#xC815;&#xB82C;"/>
                <ComboBoxItem Content="&#xCD5C;&#xC2E0;&#xC21C;"/>
                <ComboBoxItem Content="&#xC774;&#xB984;&#xC21C;"/>
            </ComboBox>

            <TextBox Grid.Column="2"
                     Style="{StaticResource BaseInputStyle}"
                     Tag="&#xD0A4;&#xC6CC;&#xB4DC;/&#xB0A0;&#xC9DC; &#xAC80;&#xC0C9;"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.45*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource ContentCardStyle}">
                <StackPanel>
                    <TextBlock Text="&#xBCF4;&#xACE0;&#xC11C; &#xBAA9;&#xB85D;"
                               Style="{StaticResource SectionTitleTextStyle}"
                               TextAlignment="Center"
                               Margin="0,0,0,20"/>

                    <ListBox x:Name="ReportListBox"
                             BorderThickness="0"
                             Background="Transparent"
                             SelectionChanged="ReportListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding VideoName}"
                                               Style="{StaticResource BodyTextStyle}"
                                               FontSize="12"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding AnalyzedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                               Style="{StaticResource MutedTextStyle}"
                                               FontSize="10"/>
                                    <TextBlock Text="{Binding EventCount, StringFormat=감지 이벤트 {0}개}"
                                               Style="{StaticResource MutedTextStyle}"
                                               FontSize="10"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource ContentCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="&#xBCF4;&#xACE0;&#xC11C; &#xBBF8;&#xB9AC;&#xBCF4;&#xAE30;"
                               Style="{StaticResource SectionTitleTextStyle}"
                               TextAlignment="Center"
                               Margin="0,0,0,20"/>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <TextBlock x:Name="EmptyReportText"
                                       Text="&#xC544;&#xC9C1; &#xBCF4;&#xACE0;&#xC11C;&#xAC00; &#xC5C6;&#xC2B5;&#xB2C8;&#xB2E4;."
                                       Style="{StaticResource MutedTextStyle}"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                            <ContentControl x:Name="ReportPreviewContent"
                                        HorizontalAlignment="Center"
                                        ContentTemplate="{StaticResource DetectionReportTemplate}"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
