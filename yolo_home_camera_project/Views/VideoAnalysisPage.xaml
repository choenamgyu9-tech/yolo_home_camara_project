<Page x:Class="yolo_home_camera_project.Views.VideoAnalysisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource AppBackgroundBrush}"
      AllowDrop="True"
      Focusable="True"
      PreviewDragEnter="VideoDropArea_DragEnter"
      PreviewDragOver="VideoDropArea_DragOver"
      PreviewDragLeave="VideoDropArea_DragLeave"
      PreviewDrop="VideoDropArea_Drop"
      PreviewKeyDown="Page_PreviewKeyDown"
      Unloaded="Page_Unloaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Video Analysis"
                   Style="{StaticResource PageTitleTextStyle}"/>

        <Grid Grid.Row="1"
              Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <Grid Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.3*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border x:Name="VideoDropArea"
                        Style="{StaticResource VideoSurfaceStyle}"
                        AllowDrop="True"
                        PreviewDragEnter="VideoDropArea_DragEnter"
                        PreviewDragOver="VideoDropArea_DragOver"
                        PreviewDragLeave="VideoDropArea_DragLeave"
                        PreviewDrop="VideoDropArea_Drop">
                    <Grid AllowDrop="True">
                        <MediaElement x:Name="VideoPlayer"
                                      AllowDrop="True"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Manual"
                                      Stretch="Uniform"
                                      MediaOpened="VideoPlayer_MediaOpened"
                                      MediaEnded="VideoPlayer_MediaEnded"/>
                        <TextBlock x:Name="EmptyVideoText"
                                   Text="Open or drag an MP4 file here"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   FontFamily="{StaticResource AppFontFamily}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Style="{StaticResource ContentCardStyle}"
                        Margin="0,12,0,12"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PlayPauseButton"
                                Content="&#x25B6;"
                                Style="{StaticResource IconButtonStyle}"
                                FontSize="16"
                                ToolTip="Play/Pause"
                                Click="PlayPauseButton_Click"/>
                        <Button Grid.Column="1"
                                Content="&#x25A0;"
                                Style="{StaticResource IconButtonStyle}"
                                FontSize="16"
                                Margin="8,0,0,0"
                                ToolTip="Stop"
                                Click="StopButton_Click"/>
                        <ComboBox x:Name="PlaybackSpeedComboBox"
                                  Grid.Column="4"
                                  Style="{StaticResource BaseComboBoxStyle}"
                                  Width="92"
                                  Height="34"
                                  SelectedIndex="2"
                                  SelectionChanged="PlaybackSpeedComboBox_SelectionChanged">
                            <ComboBoxItem Content="0.5x" Tag="0.5"/>
                            <ComboBoxItem Content="0.75x" Tag="0.75"/>
                            <ComboBoxItem Content="1x" Tag="1"/>
                            <ComboBoxItem Content="1.25x" Tag="1.25"/>
                            <ComboBoxItem Content="1.5x" Tag="1.5"/>
                            <ComboBoxItem Content="2x" Tag="2"/>
                        </ComboBox>

                        <Slider x:Name="PositionSlider"
                                Grid.Row="1"
                                Grid.ColumnSpan="4"
                                Style="{StaticResource BaseSliderStyle}"
                                Margin="0,12,12,0"
                                Minimum="0"
                                ValueChanged="PositionSlider_ValueChanged"
                                PreviewMouseDown="PositionSlider_PreviewMouseDown"
                                PreviewMouseUp="PositionSlider_PreviewMouseUp"/>
                        <TextBlock x:Name="PlaybackTimeText"
                                   Grid.Row="1"
                                   Grid.Column="4"
                                   Text="00:00 / 00:00"
                                   Style="{StaticResource BodyTextStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,12,0,0"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Style="{StaticResource ContentCardStyle}"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="Analysis Status"
                                   Style="{StaticResource SectionTitleTextStyle}"/>

                        <TextBlock x:Name="SelectedVideoText"
                                   Text="Selected video: none"
                                   Style="{StaticResource BodyTextStyle}"
                                   Margin="0,0,0,8"/>

                        <TextBlock x:Name="ActiveKeywordsText"
                                   Text="Active keywords: none"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,8">
                            <TextBlock Text="Confidence:"
                                       Style="{StaticResource BodyTextStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>

                            <TextBox x:Name="ConfidenceTextBox"
                                     Style="{StaticResource BaseInputStyle}"
                                     Tag="&#xC2E0;&#xB8B0;&#xB3C4;"
                                     Width="70"
                                     Text="0.5"/>

                            <TextBlock Text="Stride:"
                                       Style="{StaticResource BodyTextStyle}"
                                       VerticalAlignment="Center"
                                       Margin="16,0,8,0"/>

                            <TextBox x:Name="VidStrideTextBox"
                                     Style="{StaticResource BaseInputStyle}"
                                     Tag="Stride"
                                     Width="70"
                                     Text="5"/>
                        </StackPanel>

                        <Button x:Name="AnalyzeButton"
                                Content="YOLOE &#xBD84;&#xC11D; &#xC2DC;&#xC791;"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,0,8"
                                Click="AnalyzeButton_Click"/>

                        <TextBlock x:Name="AnalysisStatusText"
                                   Text="Status: waiting"
                                   Style="{StaticResource StatusTextStyle}"
                                   Margin="0,0,0,8"/>

                        <TextBlock x:Name="AnalysisProgressText"
                                   Text="Progress: 0%"
                                   Style="{StaticResource StatusTextStyle}"
                                   Margin="0,0,0,8"/>

                        <ProgressBar x:Name="AnalysisProgressBar"
                                     Height="14"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource ContentCardStyle}"
                        Padding="16"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Video List"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Style="{StaticResource IconButtonStyle}"
                                        ToolTip="Open Videos folder"
                                        Click="OpenVideosFolderButton_Click">
                                    <Image Source="/folder_icon.png"
                                           Stretch="Uniform"/>
                                </Button>
                                <Button x:Name="SortMenuButton"
                                        Content="&#9776;"
                                        Style="{StaticResource IconButtonStyle}"
                                        Margin="8,0,0,0"
                                        FontSize="16"
                                        ToolTip="Sort videos"
                                        Click="ToggleSortPanelButton_Click"/>
                            </StackPanel>
                            <Popup x:Name="SortPopup"
                                   PlacementTarget="{Binding ElementName=SortMenuButton}"
                                   Placement="Bottom"
                                   HorizontalOffset="-108"
                                   StaysOpen="False"
                                   AllowsTransparency="True">
                                <Border Width="150"
                                        Background="{StaticResource CardBackgroundBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1"
                                        Padding="6">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10"
                                                          ShadowDepth="2"
                                                          Opacity="0.22"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="1"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="1"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="1"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="1"/>
                                            <RowDefinition Height="30"/>
                                        </Grid.RowDefinitions>

                                        <Button Grid.Row="0"
                                                Style="{StaticResource BaseButtonStyle}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Click="SortByNameButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="NameSortMark"
                                                           Text="&#8226;"
                                                           FontSize="18"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="&#xC774;&#xB984;&#xC21C;"
                                                           Style="{StaticResource BodyTextStyle}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                        <Border Grid.Row="1" Background="#FFEDEDED"/>

                                        <Button Grid.Row="2"
                                                Style="{StaticResource BaseButtonStyle}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Click="SortByCreatedButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="CreatedSortMark"
                                                           FontSize="18"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="&#xCD94;&#xAC00;&#xB0A0;&#xC9DC;&#xC21C;"
                                                           Style="{StaticResource BodyTextStyle}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                        <Border Grid.Row="3" Background="#FFEDEDED"/>

                                        <Button Grid.Row="4"
                                                Style="{StaticResource BaseButtonStyle}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Click="SortByAddedButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="AddedSortMark"
                                                           FontSize="18"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="&#xB9CC;&#xB4E4;&#xC5B4;&#xC9C4; &#xC21C;"
                                                           Style="{StaticResource BodyTextStyle}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                        <Border Grid.Row="5" Background="#FFD8D8D8"/>

                                        <Button Grid.Row="6"
                                                Style="{StaticResource BaseButtonStyle}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Click="SortAscendingButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="AscendingSortMark"
                                                           Text="&#8226;"
                                                           FontSize="18"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="&#xC624;&#xB984;&#xCC28;&#xC21C;"
                                                           Style="{StaticResource BodyTextStyle}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                        <Border Grid.Row="7" Background="#FFEDEDED"/>

                                        <Button Grid.Row="8"
                                                Style="{StaticResource BaseButtonStyle}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Click="SortDescendingButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="DescendingSortMark"
                                                           FontSize="18"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="&#xB0B4;&#xB9BC;&#xCC28;&#xC21C;"
                                                           Style="{StaticResource BodyTextStyle}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                        <ListBox x:Name="VideoListBox"
                                 Grid.Row="1"
                                 DisplayMemberPath="Title"
                                 SelectionChanged="VideoListBox_SelectionChanged"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Style="{StaticResource ContentCardStyle}"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Detected Objects"
                                   Style="{StaticResource SectionTitleTextStyle}"/>

                        <ListBox x:Name="TimelineListBox"
                                 Grid.Row="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 SelectionChanged="TimelineListBox_SelectionChanged"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TimelineEventCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="82"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Style="{StaticResource TimelineThumbnailStyle}"/>

                                            <StackPanel Grid.Column="1"
                                                        Margin="10,0,0,0">
                                                <TextBlock Text="{Binding Keyword}"
                                                           Style="{StaticResource SectionTitleTextStyle}"
                                                           FontSize="16"
                                                           Margin="0"/>

                                                <TextBlock Style="{StaticResource MutedTextStyle}"
                                                           Margin="0,4,0,0">
                                                    <Run Text="{Binding StartTime}"/>
                                                    <Run Text=" - "/>
                                                    <Run Text="{Binding EndTime}"/>
                                                </TextBlock>

                                                <TextBlock Style="{StaticResource MutedTextStyle}"
                                                           Margin="0,4,0,0">
                                                    <Run Text="Count: "/>
                                                    <Run Text="{Binding DetectionCount}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <Border Grid.Column="2"
                                                    Style="{StaticResource ConfidenceBadgeStyle}">
                                                <TextBlock FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           Style="{StaticResource BodyTextStyle}"
                                                           Text="{Binding MaxConfidence, StringFormat={}{0:P0}}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
