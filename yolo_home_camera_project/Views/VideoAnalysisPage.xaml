<Page x:Class="yolo_home_camera_project.Views.VideoAnalysisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FFF7F7F7"
      AllowDrop="True"
      Focusable="True"
      PreviewDragEnter="VideoDropArea_DragEnter"
      PreviewDragOver="VideoDropArea_DragOver"
      PreviewDragLeave="VideoDropArea_DragLeave"
      PreviewDrop="VideoDropArea_Drop"
      PreviewKeyDown="Page_PreviewKeyDown"
      Unloaded="Page_Unloaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Video Analysis" FontSize="28" FontWeight="Bold"/>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <Grid Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.3*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border x:Name="VideoDropArea"
                        Background="#FF202124"
                        CornerRadius="6"
                        ClipToBounds="True"
                        AllowDrop="True"
                        PreviewDragEnter="VideoDropArea_DragEnter"
                        PreviewDragOver="VideoDropArea_DragOver"
                        PreviewDragLeave="VideoDropArea_DragLeave"
                        PreviewDrop="VideoDropArea_Drop">
                    <Grid AllowDrop="True">
                        <MediaElement x:Name="VideoPlayer"
                                      AllowDrop="True"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Manual"
                                      Stretch="Uniform"
                                      MediaOpened="VideoPlayer_MediaOpened"
                                      MediaEnded="VideoPlayer_MediaEnded"/>
                        <TextBlock x:Name="EmptyVideoText"
                                   Text="Open or drag an MP4 file here"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,12,0,12"
                        Background="White"
                        BorderBrush="#FFD9D9D9"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PlayPauseButton"
                                Content="&#x25B6;"
                                Width="42"
                                Height="34"
                                FontSize="16"
                                ToolTip="Play/Pause"
                                Click="PlayPauseButton_Click"/>
                        <Button Grid.Column="1"
                                Content="&#x25A0;"
                                Width="42"
                                Height="34"
                                FontSize="16"
                                Margin="8,0,0,0"
                                ToolTip="Stop"
                                Click="StopButton_Click"/>
                        <ComboBox x:Name="PlaybackSpeedComboBox"
                                  Grid.Column="4"
                                  Width="92"
                                  Height="34"
                                  SelectedIndex="2"
                                  SelectionChanged="PlaybackSpeedComboBox_SelectionChanged">
                            <ComboBoxItem Content="0.5x" Tag="0.5"/>
                            <ComboBoxItem Content="0.75x" Tag="0.75"/>
                            <ComboBoxItem Content="1x" Tag="1"/>
                            <ComboBoxItem Content="1.25x" Tag="1.25"/>
                            <ComboBoxItem Content="1.5x" Tag="1.5"/>
                            <ComboBoxItem Content="2x" Tag="2"/>
                        </ComboBox>

                        <Slider x:Name="PositionSlider"
                                Grid.Row="1"
                                Grid.ColumnSpan="4"
                                Margin="0,12,12,0"
                                Minimum="0"
                                ValueChanged="PositionSlider_ValueChanged"
                                PreviewMouseDown="PositionSlider_PreviewMouseDown"
                                PreviewMouseUp="PositionSlider_PreviewMouseUp"/>
                        <TextBlock x:Name="PlaybackTimeText"
                                   Grid.Row="1"
                                   Grid.Column="4"
                                   Text="00:00 / 00:00"
                                   VerticalAlignment="Center"
                                   Margin="0,12,0,0"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="White" BorderBrush="#FFD9D9D9" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Analysis Status"
               FontSize="18"
               FontWeight="Bold"
               Margin="0,0,0,12"/>

                        <TextBlock x:Name="SelectedVideoText"
               Text="Selected video: none"
               Margin="0,0,0,8"/>

                        <TextBlock x:Name="ActiveKeywordsText"
               Text="Active keywords: none"
               TextWrapping="Wrap"
               Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Confidence:"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0"/>

                            <TextBox x:Name="ConfidenceTextBox"
                 Width="70"
                 Text="0.5"/>

                            <TextBlock Text="Stride:"
                   VerticalAlignment="Center"
                   Margin="16,0,8,0"/>

                            <TextBox x:Name="VidStrideTextBox"
                 Width="70"
                 Text="5"/>
                        </StackPanel>

                        <Button x:Name="AnalyzeButton"
            Content="YOLOE 분석 시작"
            Height="36"
            Margin="0,0,0,8"
            Click="AnalyzeButton_Click"/>

                        <TextBlock x:Name="AnalysisStatusText"
               Text="Status: waiting"
               Margin="0,0,0,8"/>

                        <TextBlock x:Name="AnalysisProgressText"
               Text="Progress: 0%"
               Margin="0,0,0,8"/>

                        <ProgressBar x:Name="AnalysisProgressBar"
                 Height="14"
                 Minimum="0"
                 Maximum="100"
                 Value="0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="White" BorderBrush="#FFD9D9D9" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Video List"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Width="34"
                                        Height="30"
                                        Padding="5"
                                        ToolTip="Open Videos folder"
                                        Click="OpenVideosFolderButton_Click">
                                    <Image Source="/folder_icon.png"
                                           Stretch="Uniform"/>
                                </Button>
                                <Button x:Name="SortMenuButton"
                                        Content="&#9776;"
                                        Width="34"
                                        Height="30"
                                        Margin="8,0,0,0"
                                        FontSize="16"
                                        ToolTip="Sort videos"
                                        Click="ToggleSortPanelButton_Click"/>
                            </StackPanel>
                            <Popup x:Name="SortPopup"
                                   PlacementTarget="{Binding ElementName=SortMenuButton}"
                                   Placement="Bottom"
                                   HorizontalOffset="-108"
                                   StaysOpen="False"
                                   AllowsTransparency="True">
                                <Border Width="150"
                                        Background="White"
                                        BorderBrush="#FFC8C8C8"
                                        BorderThickness="1"
                                        Padding="6">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10"
                                                          ShadowDepth="2"
                                                          Opacity="0.22"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="1"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="1"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="1"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="1"/>
                                            <RowDefinition Height="30"/>
                                        </Grid.RowDefinitions>

                                        <Button Grid.Row="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Click="SortByNameButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="NameSortMark"
                                                           Text="&#8226;"
                                                           FontSize="18"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="&#xC774;&#xB984;&#xC21C;"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                        <Border Grid.Row="1" Background="#FFEDEDED"/>

                                        <Button Grid.Row="2"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Click="SortByCreatedButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="CreatedSortMark"
                                                           FontSize="18"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="&#xCD94;&#xAC00;&#xB0A0;&#xC9DC;&#xC21C;"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                        <Border Grid.Row="3" Background="#FFEDEDED"/>

                                        <Button Grid.Row="4"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Click="SortByAddedButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="AddedSortMark"
                                                           FontSize="18"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="&#xB9CC;&#xB4E4;&#xC5B4;&#xC9C4; &#xC21C;"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                        <Border Grid.Row="5" Background="#FFD8D8D8"/>

                                        <Button Grid.Row="6"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Click="SortAscendingButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="AscendingSortMark"
                                                           Text="&#8226;"
                                                           FontSize="18"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="&#xC624;&#xB984;&#xCC28;&#xC21C;"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                        <Border Grid.Row="7" Background="#FFEDEDED"/>

                                        <Button Grid.Row="8"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Click="SortDescendingButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="DescendingSortMark"
                                                           FontSize="18"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="&#xB0B4;&#xB9BC;&#xCC28;&#xC21C;"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                        <ListBox x:Name="VideoListBox"
                                 Grid.Row="1"
                                 DisplayMemberPath="Title"
                                 SelectionChanged="VideoListBox_SelectionChanged"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="White" BorderBrush="#FFD9D9D9" BorderThickness="1" CornerRadius="6" Padding="16">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Detected Objects" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="#FFF8F9FB" BorderBrush="#FFE0E3E8" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="72" Height="40" Background="#FF2A2D32" CornerRadius="4" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="cat" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="00:13 - 00:18" Foreground="#FF666666" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="#FFEAF3FF" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="87%" FontWeight="Bold" Foreground="#FF1B5FA7"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Background="#FFF8F9FB" BorderBrush="#FFE0E3E8" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="72" Height="40" Background="#FF2A2D32" CornerRadius="4" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="person" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="00:47 - 00:55" Foreground="#FF666666" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="#FFEAF3FF" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="91%" FontWeight="Bold" Foreground="#FF1B5FA7"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Background="#FFF8F9FB" BorderBrush="#FFE0E3E8" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="72" Height="40" Background="#FF2A2D32" CornerRadius="4" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="fire" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text="01:21 - 01:23" Foreground="#FF666666" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="#FFFFEFE8" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="76%" FontWeight="Bold" Foreground="#FFC54A18"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
