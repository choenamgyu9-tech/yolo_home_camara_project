<Page x:Class="yolo_home_camera_project.Views.VideoAnalysisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FFF7F7F7"
      AllowDrop="True"
      PreviewDragEnter="VideoDropArea_DragEnter"
      PreviewDragOver="VideoDropArea_DragOver"
      PreviewDragLeave="VideoDropArea_DragLeave"
      PreviewDrop="VideoDropArea_Drop"
      Unloaded="Page_Unloaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Video Analysis" FontSize="28" FontWeight="Bold"/>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <Grid Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.3*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border x:Name="VideoDropArea"
                        Background="#FF202124"
                        CornerRadius="6"
                        ClipToBounds="True"
                        AllowDrop="True"
                        PreviewDragEnter="VideoDropArea_DragEnter"
                        PreviewDragOver="VideoDropArea_DragOver"
                        PreviewDragLeave="VideoDropArea_DragLeave"
                        PreviewDrop="VideoDropArea_Drop">
                    <Grid AllowDrop="True">
                        <MediaElement x:Name="VideoPlayer"
                                      AllowDrop="True"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Manual"
                                      Stretch="Uniform"
                                      MediaOpened="VideoPlayer_MediaOpened"
                                      MediaEnded="VideoPlayer_MediaEnded"/>
                        <TextBlock x:Name="EmptyVideoText"
                                   Text="Open or drag an MP4 file here"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,12,0,12"
                        Background="White"
                        BorderBrush="#FFD9D9D9"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="Open"
                                Width="92"
                                Height="34"
                                Click="OpenVideoButton_Click"/>
                        <Button Grid.Column="1"
                                Content="Play"
                                Width="64"
                                Height="34"
                                Margin="8,0,0,0"
                                Click="PlayButton_Click"/>
                        <Button Grid.Column="2"
                                Content="Pause"
                                Width="76"
                                Height="34"
                                Margin="8,0,0,0"
                                Click="PauseButton_Click"/>
                        <Button Grid.Column="4"
                                Content="Stop"
                                Width="64"
                                Height="34"
                                Margin="8,0,0,0"
                                Click="StopButton_Click"/>

                        <Slider x:Name="PositionSlider"
                                Grid.Row="1"
                                Grid.ColumnSpan="4"
                                Margin="0,12,12,0"
                                Minimum="0"
                                ValueChanged="PositionSlider_ValueChanged"
                                PreviewMouseDown="PositionSlider_PreviewMouseDown"
                                PreviewMouseUp="PositionSlider_PreviewMouseUp"/>
                        <TextBlock x:Name="PlaybackTimeText"
                                   Grid.Row="1"
                                   Grid.Column="4"
                                   Text="00:00 / 00:00"
                                   VerticalAlignment="Center"
                                   Margin="0,12,0,0"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="White" BorderBrush="#FFD9D9D9" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Analysis Status" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock x:Name="SelectedVideoText" Text="Selected video: none" Margin="0,0,0,8"/>
                        <TextBlock Text="Status: waiting" Margin="0,0,0,8"/>
                        <TextBlock Text="Progress: 0%" Margin="0,0,0,8"/>
                        <ProgressBar Height="14" Value="0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="White" BorderBrush="#FFD9D9D9" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Video List"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Width="34"
                                        Height="30"
                                        Padding="5"
                                        ToolTip="Open Videos folder"
                                        Click="OpenVideosFolderButton_Click">
                                    <Image Source="/folder_icon.png"
                                           Stretch="Uniform"/>
                                </Button>
                                <Button x:Name="SortMenuButton"
                                        Content="&#9776;"
                                        Width="34"
                                        Height="30"
                                        Margin="8,0,0,0"
                                        FontSize="16"
                                        ToolTip="Sort videos"
                                        Click="ToggleSortPanelButton_Click"/>
                            </StackPanel>
                            <Popup x:Name="SortPopup"
                                   PlacementTarget="{Binding ElementName=SortMenuButton}"
                                   Placement="Bottom"
                                   HorizontalOffset="-108"
                                   StaysOpen="False"
                                   AllowsTransparency="True">
                                <Border Width="150"
                                        Background="White"
                                        BorderBrush="#FFC8C8C8"
                                        BorderThickness="1"
                                        Padding="6">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10"
                                                          ShadowDepth="2"
                                                          Opacity="0.22"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="1"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="1"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="1"/>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="1"/>
                                            <RowDefinition Height="30"/>
                                        </Grid.RowDefinitions>

                                        <Button Grid.Row="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Click="SortByNameButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="NameSortMark"
                                                           Text="&#8226;"
                                                           FontSize="18"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="&#xC774;&#xB984;&#xC21C;"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                        <Border Grid.Row="1" Background="#FFEDEDED"/>

                                        <Button Grid.Row="2"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Click="SortByCreatedButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="CreatedSortMark"
                                                           FontSize="18"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="&#xCD94;&#xAC00;&#xB0A0;&#xC9DC;&#xC21C;"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                        <Border Grid.Row="3" Background="#FFEDEDED"/>

                                        <Button Grid.Row="4"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Click="SortByAddedButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="AddedSortMark"
                                                           FontSize="18"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="&#xB9CC;&#xB4E4;&#xC5B4;&#xC9C4; &#xC21C;"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                        <Border Grid.Row="5" Background="#FFD8D8D8"/>

                                        <Button Grid.Row="6"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Click="SortAscendingButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="AscendingSortMark"
                                                           Text="&#8226;"
                                                           FontSize="18"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="&#xC624;&#xB984;&#xCC28;&#xC21C;"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                        <Border Grid.Row="7" Background="#FFEDEDED"/>

                                        <Button Grid.Row="8"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Click="SortDescendingButton_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="DescendingSortMark"
                                                           FontSize="18"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="&#xB0B4;&#xB9BC;&#xCC28;&#xC21C;"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                        <ListBox x:Name="VideoListBox"
                                 Grid.Row="1"
                                 DisplayMemberPath="Title"
                                 SelectionChanged="VideoListBox_SelectionChanged"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="White" BorderBrush="#FFD9D9D9" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Detected Objects" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="00:13 - 00:18   cat   87%"/>
                        <TextBlock Text="00:47 - 00:55   person   91%"/>
                        <TextBlock Text="01:21 - 01:23   fire   76%"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
