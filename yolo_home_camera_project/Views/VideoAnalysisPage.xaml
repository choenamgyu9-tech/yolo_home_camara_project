<Page x:Class="yolo_home_camera_project.Views.VideoAnalysisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FFF7F7F7">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Video Analysis" FontSize="28" FontWeight="Bold"/>
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
            <Grid Margin="0,0,12,0">
                <Grid.RowDefinitions><RowDefinition Height="2.3*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="#FF202124" CornerRadius="6"><TextBlock Text="동영상" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <Border Grid.Row="1" Margin="0,12,0,12" Background="White" BorderBrush="#FFD9D9D9" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel><TextBlock Text="타임라인" FontWeight="Bold" Margin="0,0,0,10"/><ProgressBar Height="14" Value="62"/></StackPanel>
                </Border>
                <Border Grid.Row="2" Background="White" BorderBrush="#FFD9D9D9" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <TextBlock Text="분석 상태" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="분석 상태: 분석 중"/>
                        <TextBlock Text="현재 영상 길이: 03:25"/>
                        <TextBlock Text="분석 진행률: 62%"/>
                        <TextBlock Text="감지된 이벤트 수: 12개"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="White" BorderBrush="#FFD9D9D9" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel><TextBlock Text="동영상 목록" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/><TextBlock Text="sample_01.mp4"/><TextBlock Text="sample_02.mp4"/><TextBlock Text="sample_03.mp4"/></StackPanel>
                </Border>
                <Border Grid.Row="1" Background="White" BorderBrush="#FFD9D9D9" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <TextBlock Text="감지된 객체" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="00:13 - 00:18   cat   87%"/>
                        <TextBlock Text="00:47 - 00:55   person   91%"/>
                        <TextBlock Text="01:21 - 01:23   fire   76%"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
