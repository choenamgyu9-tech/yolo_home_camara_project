<Page x:Class="yolo_home_camera_project.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Settings"
                   Style="{StaticResource PageTitleTextStyle}"/>

        <Grid Grid.Row="1"
              Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource ContentCardStyle}"
                    Margin="0,0,12,0"
                    Padding="16">
                <StackPanel>
                    <Button Content="비디오 설정"
                            Style="{StaticResource NavigationButtonStyle}"/>
                    <Button Content="키워드 설정"
                            Style="{StaticResource NavigationButtonStyle}"/>
                    <Button Content="타임라인 설정"
                            Style="{StaticResource NavigationButtonStyle}"/>
                    <Button Content="보고서 설정"
                            Style="{StaticResource NavigationButtonStyle}"
                            Margin="0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource ContentCardStyle}">
                <StackPanel>
                    <TextBlock Text="영상 저장 경로"
                               Style="{StaticResource BodyTextStyle}"
                               FontWeight="Bold"/>
                    <TextBox Style="{StaticResource BaseInputStyle}"
                             Tag="영상 저장 경로"/>
                    <TextBlock Text="스냅샷 저장 경로"
                               Style="{StaticResource BodyTextStyle}"
                               FontWeight="Bold"
                               Margin="0,16,0,0"/>
                    <TextBox Style="{StaticResource BaseInputStyle}"
                             Tag="스냅샷 저장 경로"/>
                    <TextBlock Text="보고서 저장 경로"
                               Style="{StaticResource BodyTextStyle}"
                               FontWeight="Bold"
                               Margin="0,16,0,0"/>
                    <TextBox Style="{StaticResource BaseInputStyle}"
                             Tag="보고서 저장 경로"/>
                    <TextBlock Text="최소 신뢰도 설정"
                               Style="{StaticResource BodyTextStyle}"
                               FontWeight="Bold"
                               Margin="0,16,0,0"/>
                    <Slider Style="{StaticResource BaseSliderStyle}"
                            Minimum="0"
                            Maximum="100"
                            Value="70"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
