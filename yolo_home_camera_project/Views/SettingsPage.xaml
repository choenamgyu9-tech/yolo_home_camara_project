<Page x:Class="yolo_home_camera_project.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#FFF7F7F7">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Settings" FontSize="28" FontWeight="Bold"/>
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Margin="0,0,12,0" Background="White" BorderBrush="#FFD9D9D9" BorderThickness="1" CornerRadius="6" Padding="16">
                <StackPanel><Button Content="비디오 설정" Height="42"/><Button Content="키워드 설정" Height="42"/><Button Content="타임라인 설정" Height="42"/><Button Content="보고서 설정" Height="42"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Background="White" BorderBrush="#FFD9D9D9" BorderThickness="1" CornerRadius="6" Padding="18">
                <StackPanel>
                    <TextBlock Text="영상 저장 경로" FontWeight="Bold"/><TextBox Height="36"/>
                    <TextBlock Text="스냅샷 저장 경로" FontWeight="Bold" Margin="0,16,0,0"/><TextBox Height="36"/>
                    <TextBlock Text="보고서 저장 경로" FontWeight="Bold" Margin="0,16,0,0"/><TextBox Height="36"/>
                    <TextBlock Text="최소 신뢰도 설정" FontWeight="Bold" Margin="0,16,0,0"/><Slider Minimum="0" Maximum="100" Value="70"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
