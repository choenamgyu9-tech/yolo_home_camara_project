<Window x:Class="yolo_home_camera_project.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:yolo_home_camera_project"
        mc:Ignorable="d"
        Title="YOLO Home Camera"
        Height="450"
        Width="800">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Button x:Name="MenuToggleButton"
                        Content="&#x2630;"
                        Style="{StaticResource IconButtonStyle}"
                        FontSize="20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Click="MenuToggleButton_Click"/>

                <TextBlock Text="YOLO Home Camera"
                           Style="{StaticResource SectionTitleTextStyle}"
                           Margin="58,0,0,0"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Frame x:Name="MainFrame"
               Grid.Row="1"
               Margin="20"
               NavigationUIVisibility="Hidden"/>

        <Border x:Name="SideMenuPanel"
                Grid.RowSpan="2"
                Width="220"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,1,0"
                HorizontalAlignment="Left"
                RenderTransformOrigin="0,0"
                Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SideMenuTranslateTransform" X="-220"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="20,0">
                        <Button Content="&#x2630;"
                                Style="{StaticResource IconButtonStyle}"
                                FontSize="20"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Click="MenuToggleButton_Click"/>

                        <TextBlock Text="&#xD398;&#xC774;&#xC9C0;"
                                   Style="{StaticResource SectionTitleTextStyle}"
                                   Margin="58,0,0,0"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1"
                            Margin="12">
                    <Button Content="&#xD648; &#xD654;&#xBA74;"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="HomeButton_Click"/>
                    <Button Content="&#xC601;&#xC0C1; &#xBD84;&#xC11D; &#xD654;&#xBA74;"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="VideoAnalysisButton_Click"/>
                    <Button Content="&#xD0A4;&#xC6CC;&#xB4DC; &#xAD00;&#xB9AC; &#xD654;&#xBA74;"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="KeywordManageButton_Click"/>
                    <Button Content="&#xBCF4;&#xACE0;&#xC11C; &#xD654;&#xBA74;"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="ReportButton_Click"/>
                    <Button Content="&#xC124;&#xC815; &#xD654;&#xBA74;"
                            Style="{StaticResource NavigationButtonStyle}"
                            Margin="0"
                            Click="SettingsButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
